DB_HOST=mspr-healthai-db
DB_PORT=5432
DB_NAME=healthai
DB_USER=healthai_user
DB_PASSWORD=password
OLLAMA_HOST=http://ollama:11434
# Options d'inference Ollama. num_ctx explicite : le defaut Ollama tronque
# silencieusement le prompt few-shot. Temperature basse : sorties JSON
# contraintes par schema, on privilegie le determinisme.
OLLAMA_MODEL=gemma3:4b
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.2
# Couches offloadees sur GPU (vide = estimation auto d'Ollama). Sur carte 4 Go
# type Quadro P1000, l'auto-estimation est trop prudente : 99 force le modele
# entier en VRAM (verifie : 2.8 Go, 100 % GPU).
# OLLAMA_NUM_GPU=99
# Exemples few-shot complets (7j/5j/1j) au lieu du 1er jour seul. A reserver
# aux infra GPU : le prefill CPU de Gemma3:4b timeout au-dela de ~2000 tokens.
FEW_SHOT_FULL_EXAMPLES=false
BETTER_AUTH_SECRET=change-me-shared-with-mspr-auth
AUTH_API_URL=http://mspr-auth-service:3000
# Backend LLM par defaut (PRD #71 slice 3) : "mistral" (free tier API) ou
# "ollama" (gemma3:4b local). Surcharge par utilisateur via la preference
# nutrition_goals.preferred_llm. Remplace l'ancien LLM_BACKEND.
DEFAULT_LLM=mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1
# Backend de classification photo (route A1) : "mistral_vision" reconnait les
# plats Food-101 ET les aliments simples (pomme, banane, yaourt...), avec repli
# automatique sur "food101" (HuggingFace local) si l'API echoue ou si la clef
# est absente. "food101" = 100 % local, limite aux 101 plats prepares.
ANALYZE_BACKEND=mistral_vision
